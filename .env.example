# ===========================================
# ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and configure values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Set to "true" for Azure deployment, "false" for local Docker
USE_AZURE=false

# Debug mode (set to "true" for SQL query logging)
DEBUG=false

# ----- LOCAL DOCKER DATABASE -----
# Use these values when running with docker-compose locally
# DATABASE_URL=postgresql://tickets_user:tickets_password@db:5432/tickets_db
# POSTGRES_USER=tickets_user
# POSTGRES_PASSWORD=tickets_password
# POSTGRES_DB=tickets_db

# ----- AZURE DATABASE FOR POSTGRESQL -----
# Use these values when deploying to Azure
# Get connection string from Azure Portal > Your Database > Connection strings
# Format: postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<database>?sslmode=require
# DATABASE_URL=postgresql://adminuser@myserver:MyPassword123!@myserver.postgres.database.azure.com:5432/tickets_db

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===========================================
# DEFAULT LOCAL CONFIGURATION (Ready to use)
# ===========================================
DATABASE_URL=postgresql://tickets_user:tickets_password@db:5432/tickets_db
POSTGRES_USER=tickets_user
POSTGRES_PASSWORD=tickets_password
POSTGRES_DB=tickets_db
